# syntax=docker/dockerfile:1
# Frontend React em modo dev — Vite + HMR (hot reload).

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY packages/shared/package.json ./packages/shared/

RUN npm ci --ignore-scripts --workspace=frontend

COPY packages/shared ./packages/shared

ENV VITE_DEV_HOST=0.0.0.0
ENV VITE_USE_POLLING=true
ENV VITE_DEV_API_PROXY_TARGET=http://api:3001
ENV VITE_HMR_CLIENT_PORT=5173

EXPOSE 5173

CMD ["npm", "run", "dev", "--workspace=frontend", "--", "--host", "0.0.0.0"]
